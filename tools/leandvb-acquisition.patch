+    // How far below the MODCOD's Es/N0 a first PLHEADER may be (dB).
+    static constexpr float PROBE_MER_MARGIN = 6;
+
+    // Maximum-likelihood PLSCODE for the first frame of a lock.
+    // The LLR decoder sees PLHEADER symbols with only the rough frequency
+    // from the differential correlator: a residual rotation of ~180 deg
+    // across the PLHEADER turns a PLSCODE into the one that differs in
+    // its second half (e.g. QPSK 3/5 -> 1/2, 5/6 -> 4/5), and the lock
+    // then follows the wrong carrier for good.  Here every allowed
+    // candidate gets its own frequency, phase and amplitude fit and the
+    // best MER wins.  A candidate whose frequency fit lands far from the
+    // LLR candidate's is skipped: the PILOTS bit negates every other
+    // symbol, which a fit would absorb as a carrier shift of Rs/2.
+    // plh_symbols[] is left unchanged.
+    int probe_plscode(const complex<float> *plh_symbols,
+		      const sampler_state *pss, int llr_index) {
+      const int PLH_LENGTH = sof.LENGTH + plscodes.LENGTH;
+      const float MAX_DFW16 = 65536.0f / 16;  // Rs/16
+      complex<float> expected[PLH_LENGTH];
+      for ( int i=0; i<sof.LENGTH; ++i ) expected[i] = sof.symbols[i];
+      int best = llr_index;
+      float best_m2 = -1, ref_fw16 = 0;
+      for ( int pass=0; pass<2; ++pass )  // LLR candidate first
+	for ( int c=0; c<plscodes.COUNT; ++c ) {
+	  if ( (c==llr_index) != (pass==0) ) continue;
+	  int mc = c >> 2, sf = (c>>1) & 1;
+	  if ( c!=llr_index &&
+	       !( mc && (modcods&(1<<mc)) && (framesizes&(1<<sf)) &&
+		  modcod_infos[mc].nslots_nf ) )
+	    continue;
+	  for ( int i=0; i<plscodes.LENGTH; ++i )
+	    expected[sof.LENGTH+i] = plscodes.symbols[c][i];
+	  complex<float> symbs[PLH_LENGTH];
+	  memcpy(symbs, plh_symbols, sizeof(symbs));
+	  sampler_state ssc = *pss;
+	  match_freq(expected, symbs, PLH_LENGTH, &ssc);
+	  if ( pass == 0 )
+	    ref_fw16 = ssc.fw16;
+	  else if ( fabsf(fmodfs(ssc.fw16-ref_fw16, 65536.0f)) > MAX_DFW16 )
+	    continue;
+	  float m2 = match_ph_amp(expected, symbs, PLH_LENGTH, &ssc);
+	  if ( m2 > best_m2 ) { best_m2 = m2; best = c; }
+	}
+      if ( sch->debug && best != llr_index )
+	fprintf(stderr, "PROBE: PLSCODE %d -> %d (ML)\n", llr_index, best);
+      return best;
+    }
+
